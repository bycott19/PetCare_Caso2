PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Datos de la clinica (opcionales, hay valores por defecto)
CLINICA_NOMBRE=Clinica Veterinaria PetCare
CLINICA_DIRECCION=Barros Arana 1000
CLINICA_COMUNA=Concepcion
CLINICA_LATITUD=-36.8270
CLINICA_LONGITUD=-73.0503

# Correo real (opcional). Sin SMTP_HOST las notificaciones quedan como SIMULADA.
# Requiere: npm install nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
